<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#304F77"/>
            <stroke android:width="2dp" android:color="#A7C7FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#294263"/>
            <stroke android:width="2dp" android:color="#B8D2FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#20334D"/>
            <stroke android:width="2dp" android:color="#78A9FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
