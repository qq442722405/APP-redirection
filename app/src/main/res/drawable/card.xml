<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#253C58"/>
            <stroke android:width="1dp" android:color="#78A9FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1C2D44"/>
            <stroke android:width="2dp" android:color="#78A9FF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#182231"/>
            <stroke android:width="1dp" android:color="#304158"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
