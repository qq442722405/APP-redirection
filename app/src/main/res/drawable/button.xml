<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#29466B"/>
            <stroke android:width="1dp" android:color="#78A9FF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#20334D"/>
            <stroke android:width="2dp" android:color="#78A9FF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1B283B"/>
            <stroke android:width="1dp" android:color="#3B526F"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
